# Claude Code 등 로컬 AI 도구 설정
.claude/
CLAUDE.md

# 임시·산출물 폴더
_workspace/
output/
tmp/
scripts/
*.log

##############################################
# 비밀값: 절대 커밋하지 않음 (CI repo-guard도 검사)
##############################################
.env
**/.env
.env.*
**/.env.*
*.env.local
# 배포용 예시 파일만 추적한다 (실제 비밀값 없음)
!.env.prod.example

*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

