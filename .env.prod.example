# 상시 운영(VPS) 배포용 환경변수 예시.
# VPS에서 `cp .env.prod.example .env` 후 모든 비밀값을 새로 생성해 채운다.
# 예시 값을 그대로 사용하면 안 된다. 생성 예: openssl rand -base64 48

### 필수: 데이터베이스
POSTGRES_PASSWORD=새로-생성한-강한-비밀번호

### 필수: 인증 (공개 데모는 JWT 활성 상태로 운영)
CHAINWATCH_JWT_ENABLED=true
CHAINWATCH_JWT_SECRET=충분히-긴-무작위-문자열
CHAINWATCH_PASSWORD_PEPPER=별도의-긴-무작위-문자열
CHAINWATCH_ADMIN_USERNAME=admin
CHAINWATCH_ADMIN_PASSWORD={noop}최초-로그인용-강한-비밀번호

### 데이터 수집 (Etherscan 무료 키: https://etherscan.io/apis)
CHAINWATCH_COLLECTOR_ENABLED=true
CHAINWATCH_ETHERSCAN_API_KEY=

### AI 분석 (키가 없으면 false로 두면 분석 없이 탐지 파이프라인만 동작)
CHAINWATCH_AI_ENABLED=true
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 프로바이더 무료 쿼터(RPM/RPD)에 맞춰 워커 처리율 조절
CHAINWATCH_AI_WORKER_POLL_INTERVAL_MS=30000
CHAINWATCH_AI_WORKER_BATCH_SIZE=3

### Named Tunnel 사용 시에만 (도메인 보유 + Cloudflare Zero Trust에서 발급)
#CLOUDFLARE_TUNNEL_TOKEN=

### 특정 버전으로 고정하고 싶을 때 (기본 latest, CD가 커밋 SHA 태그도 게시함)
#IMAGE_TAG=latest
