{
  "name": "chainwatch",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api 요청은 정적 자산보다 Worker가 먼저 받아 백엔드로 전달한다.
    "run_worker_first": ["/api/*"]
  }
}
